//to make the thing localization and reskin friendly
[esm]

//leave messages
QUITMSG1 = "Por favor, no te vayas; ¡todavía quedan más cajas de munición por encontrar!"; //XL
QUITMSG2 = "¡Vámonos de aquí! ¡Esto se está convirtiendo en un baño de sangre!";
QUITMSG3 = "Yo no me iría si fuera tú. Tu ordenador de sobremesa es mucho peor."; //XL
QUITMSG4 = "Estás intentando decir que te gusta más Ghouls vs. Humans que a mí, ¿verdad?"; //XL
QUITMSG5 = "¡No te vayas todavía; hay un ATRL a la vuelta de la esquina!"; //XL
QUITMSG6 = "La próxima vez que vengas por aquí, te voy a achicharrar.";
QUITMSG7 = "Vete si quieres. A ver si me importa.";
QUITMSG8 = "¿Quieres renunciar? ¡Entonces has perdido una octava parte!";
QUITMSG9 = "¡No te vayas ahora, hay un engendro dimensional esperando en el símbolo del sistema!";
QUITMSG10 = "Lárgate de aquí y vuelve a tus programas aburridos.";
QUITMSG11 = "¡Si fuera tu jefa, te empataría en un minuto!";
QUITMSG12 = "¡Si te vas ahora, pierdes la cuenta de tus conquistas!";
QUITMSG13 = "huehuehuehue"; //XL
QUITMSG14 = "¿Te asustó La Amenaza? ¡Vete de aquí y mírate al espejo; entonces veremos quién da miedo!"; //XL

